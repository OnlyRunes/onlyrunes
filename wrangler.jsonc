{
  // Cloudflare Worker config for OnlyRunes (static-assets sites).
  //
  // Current setup (only the beta is advertised for now):
  //   LANDING PAGE:  npx wrangler deploy --env landing -> worker "onlyrunes-site" -> onlyrunes.net
  //   BETA (game):   npx wrangler deploy --env beta    -> worker "onlyrunes-beta" -> beta.onlyrunes.net
  //
  // Planned for later (not wired up yet):
  //   LIVE (game):   npx wrangler deploy               -> worker "onlyrunes"      -> play.onlyrunes.net
  //   Until then the live worker stays on its *.workers.dev URL; no public link.
  //
  // Deploying updates the same-named worker, so custom domains + HTTPS persist.
  // Domains are attached per-worker in the Cloudflare dashboard (Settings ->
  // Domains & Routes): onlyrunes.net -> onlyrunes-site, beta.onlyrunes.net ->
  // onlyrunes-beta (and later play.onlyrunes.net -> onlyrunes).
  "name": "onlyrunes",
  "compatibility_date": "2026-06-27",
  "assets": {
    "directory": "./site"
  },
  "env": {
    "beta": {
      "name": "onlyrunes-beta",
      "assets": {
        "directory": "./site"
      }
    },
    "landing": {
      "name": "onlyrunes-site",
      "assets": {
        "directory": "./landing"
      },
      "routes": [
        { "pattern": "onlyrunes.net", "custom_domain": true }
      ]
    }
  }
}
