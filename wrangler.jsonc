{
  // Cloudflare Worker config for OnlyRunes (static-assets site).
  //
  // PRODUCTION (live):  npx wrangler deploy            -> worker "onlyrunes"      -> onlyrunes.net
  // BETA (staging):     npx wrangler deploy --env beta -> worker "onlyrunes-beta" -> beta.onlyrunes.net
  //
  // Deploying updates the same-named worker, so custom domains + HTTPS persist.
  "name": "onlyrunes-beta",
  "compatibility_date": "2026-06-27",
  "assets": {
    "directory": "./site"
  },
  "env": {
    "beta": {
      "name": "onlyrunes-beta",
      "assets": {
        "directory": "./site"
      }
    }
  }
}
